#!/bin/bash

# omarchy:summary=Install and select a dictation backend
# omarchy:requires-sudo=true
# omarchy:args=<voxtype|superwhisper>
# omarchy:examples=omarchy install dictation superwhisper

set -e

case "${1:-}" in
  voxtype|superwhisper)
    "omarchy-install-dictation-$1"
    ;;
  *)
    echo "Usage: omarchy install dictation <voxtype|superwhisper>" >&2
    exit 1
    ;;
esac
